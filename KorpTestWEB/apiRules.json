{
  "apiName": "KorpTestAPI",
  "baseRoute": "/api",
  "technology": {
    "framework": ".NET 8",
    "language": "C# 12",
    "jsonSerializer": "Newtonsoft.Json"
  },
  "authentication": {
    "enabled": false
  },
  "controllers": {
    "ProductController": {
      "route": "/api/Product",
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/Product",
          "summary": "Get all products",
          "request": null,
          "responses": {
            "200": {
              "type": "array",
              "itemsRef": "#/models/Product"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/Product/{id}",
          "summary": "Get product by id",
          "request": {
            "pathParams": {
              "id": "integer"
            }
          },
          "responses": {
            "200": {
              "ref": "#/models/Product"
            },
            "400": {
              "message": "Invalid model state"
            },
            "404": {
              "message": "Product not found"
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/Product",
          "summary": "Create product",
          "request": {
            "bodyRef": "#/dtos/CreateProductRequestDto"
          },
          "responses": {
            "201": {
              "ref": "#/models/Product"
            },
            "400": {
              "message": "Invalid model state"
            },
            "409": {
              "message": "Another product have the same code"
            }
          },
          "rules": [
            "Code must be unique",
            "CreatedAt is set by server",
            "Product is created from request DTO"
          ]
        },
        {
          "method": "PUT",
          "path": "/api/Product/{id}",
          "summary": "Update product",
          "request": {
            "pathParams": {
              "id": "integer"
            },
            "bodyRef": "#/dtos/UpdateProductRequestDto"
          },
          "responses": {
            "200": {
              "ref": "#/models/Product"
            },
            "400": {
              "message": "Invalid model state"
            },
            "404": {
              "message": "Product not found"
            }
          },
          "rules": [
            "Updates Description, StockQuantity, UpdatedAt only"
          ]
        },
        {
          "method": "DELETE",
          "path": "/api/Product/{id}",
          "summary": "Delete product",
          "request": {
            "pathParams": {
              "id": "integer"
            }
          },
          "responses": {
            "200": {
              "message": "Deleted Product with ID: {id}"
            },
            "404": {
              "message": "Product not found"
            }
          }
        }
      ]
    },
    "InvoiceController": {
      "route": "/api/Invoice",
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/Invoice",
          "summary": "Get all invoices",
          "request": null,
          "responses": {
            "200": {
              "type": "array",
              "itemsRef": "#/models/Invoice"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/Invoice/{id}",
          "summary": "Get invoice by id",
          "request": {
            "pathParams": {
              "id": "integer"
            }
          },
          "responses": {
            "200": {
              "ref": "#/models/Invoice"
            },
            "400": {
              "message": "Invalid model state"
            },
            "404": {
              "message": "Invoice not found"
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/Invoice",
          "summary": "Create invoice",
          "request": {
            "bodyRef": "#/dtos/CreateInvoiceRequestDto"
          },
          "responses": {
            "201": {
              "ref": "#/models/Invoice"
            },
            "400": {
              "message": "Invalid model state"
            }
          },
          "rules": [
            "Invoice Number is auto-generated by server",
            "Invoice Status is always set to Open",
            "CreatedAt is set by server"
          ]
        },
        {
          "method": "POST",
          "path": "/api/Invoice/{id}/print",
          "summary": "Finalize/print invoice",
          "request": {
            "pathParams": {
              "id": "integer"
            }
          },
          "responses": {
            "200": {
              "ref": "#/models/Invoice"
            },
            "400": {
              "message": "Only open invoices can be printed or unable to print invoice"
            },
            "404": {
              "message": "Invoice not found"
            }
          },
          "rules": [
            "Invoice must exist",
            "Invoice status must be Open",
            "Product stock is reduced by each invoice item quantity",
            "Invoice status becomes Closed",
            "Operation runs inside a transaction"
          ]
        },
        {
          "method": "PUT",
          "path": "/api/Invoice/{id}",
          "summary": "Update invoice",
          "request": {
            "pathParams": {
              "id": "integer"
            },
            "bodyRef": "#/dtos/UpdateInvoiceRequestDto"
          },
          "responses": {
            "200": {
              "ref": "#/models/Invoice"
            },
            "400": {
              "message": "Invalid model state"
            },
            "404": {
              "message": "Invoice not found"
            }
          }
        },
        {
          "method": "DELETE",
          "path": "/api/Invoice/{id}",
          "summary": "Delete invoice",
          "request": {
            "pathParams": {
              "id": "integer"
            }
          },
          "responses": {
            "200": {
              "message": "Deleted Invoice with ID: {id}"
            },
            "404": {
              "message": "Invoice not found"
            }
          }
        }
      ]
    },
    "InvoiceItemController": {
      "route": "/api/InvoiceItem",
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/InvoiceItem",
          "summary": "Get invoice items by product code",
          "request": {
            "queryParams": {
              "productCode": "string"
            }
          },
          "responses": {
            "200": {
              "type": "array",
              "itemsRef": "#/dtos/InvoiceDto"
            }
          },
          "rules": [
            "Product code match is case-insensitive"
          ]
        },
        {
          "method": "POST",
          "path": "/api/InvoiceItem",
          "summary": "Create invoice item",
          "request": {
            "bodyRef": "#/dtos/CreateInvoiceItemRequestDto"
          },
          "responses": {
            "201": {
              "ref": "#/models/InvoiceItem"
            },
            "400": {
              "message": "Invalid model state, invoice is not open, or quantity exceeds stock"
            },
            "404": {
              "message": "Invoice not found or Product not found"
            }
          },
          "rules": [
            "Invoice must exist",
            "Invoice status must be Open",
            "Product must exist",
            "Quantity must be less than or equal to product stock"
          ]
        },
        {
          "method": "PUT",
          "path": "/api/InvoiceItem/{id}",
          "summary": "Update invoice item quantity",
          "request": {
            "pathParams": {
              "id": "integer"
            },
            "bodyRef": "#/dtos/UpdateInvoiceItemRequestDto"
          },
          "responses": {
            "200": {
              "ref": "#/dtos/InvoiceDto"
            },
            "400": {
              "message": "Invalid model state"
            },
            "404": {
              "message": "Not found"
            }
          }
        },
        {
          "method": "DELETE",
          "path": "/api/InvoiceItem/{id}",
          "summary": "Delete invoice item",
          "request": {
            "pathParams": {
              "id": "integer"
            }
          },
          "responses": {
            "200": {
              "ref": "#/dtos/InvoiceDto"
            },
            "404": {
              "message": "Not found"
            }
          }
        }
      ]
    }
  },
  "dtos": {
    "CreateProductRequestDto": {
      "Code": {
        "type": "string",
        "required": true,
        "maxLength": 50
      },
      "Description": {
        "type": "string",
        "required": true,
        "maxLength": 200
      },
      "StockQuantity": {
        "type": "integer",
        "required": true,
        "min": 0
      }
    },
    "UpdateProductRequestDto": {
      "Description": {
        "type": "string",
        "required": true,
        "maxLength": 200
      },
      "StockQuantity": {
        "type": "integer",
        "required": true,
        "min": 0
      }
    },
    "CreateInvoiceRequestDto": {
      "Number": {
        "type": "integer",
        "required": true,
        "min": 0
      },
      "Status": {
        "type": "enum",
        "required": true,
        "values": [0, 1],
        "enumRef": "#/enums/InvoiceStatus"
      }
    },
    "UpdateInvoiceRequestDto": {
      "Status": {
        "type": "enum",
        "required": true,
        "values": [0, 1],
        "enumRef": "#/enums/InvoiceStatus"
      }
    },
    "CreateInvoiceItemRequestDto": {
      "InvoiceId": {
        "type": "integer",
        "required": true
      },
      "ProductId": {
        "type": "integer",
        "required": true
      },
      "Quantity": {
        "type": "integer",
        "required": true,
        "min": 1
      }
    },
    "UpdateInvoiceItemRequestDto": {
      "Quantity": {
        "type": "integer",
        "required": true,
        "min": 1
      }
    },
    "InvoiceDto": {
      "Id": {
        "type": "integer"
      },
      "InvoiceId": {
        "type": "integer",
        "required": true
      },
      "ProductId": {
        "type": "integer",
        "required": true
      },
      "Quantity": {
        "type": "integer",
        "required": true,
        "min": 1
      }
    }
  },
  "models": {
    "Product": {
      "Id": "integer",
      "Code": "string",
      "Description": "string",
      "StockQuantity": "integer",
      "CreatedAt": "datetime",
      "UpdatedAt": "datetime",
      "InvoiceItems": {
        "type": "array",
        "itemsRef": "#/models/InvoiceItem"
      }
    },
    "Invoice": {
      "Id": "integer",
      "Number": "integer",
      "Status": "enum",
      "StatusRef": "#/enums/InvoiceStatus",
      "CreatedAt": "datetime",
      "InvoiceItems": {
        "type": "array",
        "itemsRef": "#/models/InvoiceItem"
      }
    },
    "InvoiceItem": {
      "Id": "integer",
      "InvoiceId": "integer",
      "ProductId": "integer",
      "Quantity": "integer",
      "InvoiceRef": "#/models/Invoice",
      "ProductRef": "#/models/Product"
    }
  },
  "enums": {
    "InvoiceStatus": {
      "Open": 0,
      "Closed": 1
    }
  },
  "businessRules": [
    "Product.Code is unique.",
    "Invoice.Number is unique and auto-generated on create.",
    "Invoice create forces Status = Open.",
    "Invoice print/finalize requires Status = Open.",
    "Invoice print/finalize decreases product stock for each invoice item.",
    "Invoice items can only be added to open invoices.",
    "Invoice item quantity cannot exceed product stock.",
    "Most endpoints return raw entities; InvoiceItem list returns DTO projection."
  ],
  "database": {
    "provider": "SQL Server",
    "connectionStringName": "DefaultConnection",
    "uniqueIndexes": [
      "Products.Code",
      "Invoices.Number"
    ],
    "relationships": [
      "Invoice 1..n InvoiceItems",
      "Product 1..n InvoiceItems"
    ],
    "invoiceItemKey": [
      "InvoiceId",
      "ProductId"
    ]
  },
  "commonErrorResponses": {
    "400": "Bad Request",
    "404": "Not Found",
    "409": "Conflict"
  }
}